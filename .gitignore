# ============================================================
# JavaScript / Node.js
# ============================================================
**/node_modules/
**/.npm/
**/.npm-cache/
**/.pnpm-store/
**/.yarn/cache/
**/.vite/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
local-kb/dist/

# ============================================================
# Rust / Tauri
# ============================================================
**/target/
**/src-tauri/gen/
*.pdb
*.ilk

# Keep dependency lock files in Git:
# - local-kb/package-lock.json
# - local-kb/src-tauri/Cargo.lock

# ============================================================
# Python
# ============================================================
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/*.egg-info/
**/htmlcov/
**/.coverage
**/.coverage.*
**/*.py[cod]

# ============================================================
# Embedding models and ML artifacts
# ============================================================
local-kb/models/**
!local-kb/models/.gitkeep
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.gguf

# ============================================================
# Local databases, logs, and runtime state
# ============================================================
local-kb/data/**
!local-kb/data/.gitkeep
local-kb/logs/
local-kb/tmp/
local-kb/temp/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
*.pid

# ============================================================
# Secrets and machine-local configuration
# ============================================================
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
.codex/
.agents/

# ============================================================
# Editors, operating systems, and temporary files
# ============================================================
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~
