# DeepSeek Chat Completions API
LOCAL_KB_LLM_BASE_URL=https://api.deepseek.com
LOCAL_KB_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
# enabled/disabled. Disabled is the low-latency default for grounded RAG.
LOCAL_KB_DEEPSEEK_THINKING=disabled
# Used only when thinking is enabled: low/high/max.
LOCAL_KB_DEEPSEEK_REASONING_EFFORT=high
LOCAL_KB_LLM_TIMEOUT_SECS=300

# Python Embedding Sidecar
LOCAL_KB_EMBEDDING_BASE_URL=http://127.0.0.1:8902
# Defaults to .venv\Scripts\python.exe when it exists, otherwise python on PATH.
# Leave blank to use .venv\Scripts\python.exe and embedding-service\server.py.
LOCAL_KB_EMBEDDING_PYTHON=
LOCAL_KB_EMBEDDING_SCRIPT=
LOCAL_KB_EMBEDDING_REQUEST_TIMEOUT_SECS=180
LOCAL_KB_EMBEDDING_START_TIMEOUT_SECS=30
LOCAL_KB_EMBEDDING_BATCH_SIZE=32

# Keep 1 for an offline deployment. Set to 0 only while intentionally downloading models.
LOCAL_KB_EMBEDDING_OFFLINE=1
# Optional local model paths. If omitted, Hugging Face cache/model IDs are used.
LOCAL_KB_MODEL_BGE_SMALL=
LOCAL_KB_MODEL_M3E_BASE=
LOCAL_KB_MODEL_BGE_M3=
